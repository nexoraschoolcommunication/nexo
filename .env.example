# Public — safe to ship to the browser (Supabase anon key is RLS-gated, not a secret)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only — never prefixed with NEXT_PUBLIC_, never imported into client components
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=

# Google OAuth is configured inside Supabase Auth → Providers, not here.
# Google Calendar API scopes (only needed if/when you upgrade the meeting
# generator to auto-create calendar invites):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
